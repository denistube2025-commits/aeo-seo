---
---
<section class="py-20 bg-surface-container-high">
  <div class="container mx-auto px-4 md:px-6 max-w-7xl text-center">
    
    <div class="max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-text-main mb-6">
        Как это выглядит
      </h2>
      <p class="text-lg md:text-xl text-text-soft">
        Ниже — фрагмент разбора для завода металлоконструкций. Название компании скрыто по договорённости.
      </p>
    </div>

    <!-- Video Placeholder / Demo wrapper -->
    <div class="max-w-4xl mx-auto bg-black rounded-2xl overflow-hidden shadow-2xl relative aspect-video border border-white/10 group cursor-pointer">
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent z-10"></div>
      
      <!-- Video cover image -->
      <img src="/hero-chat-ui.png" alt="Демонстрация видеоразбора" class="w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity duration-500" />
      
      <!-- Play Button Overlay -->
      <div class="absolute inset-0 z-20 flex items-center justify-center">
        <div class="w-20 h-20 bg-primary/90 rounded-full flex items-center justify-center shadow-[0_0_40px_rgba(53,37,205,0.6)] transform group-hover:scale-110 transition-transform duration-300">
          <span class="material-symbols-outlined fill text-white text-5xl ml-2">play_arrow</span>
        </div>
      </div>
      
      <!-- Progress Bar & Controls mock -->
      <div class="absolute bottom-0 left-0 right-0 p-4 z-20 flex flex-col gap-2">
        <div class="w-full h-1.5 bg-white/30 rounded-full overflow-hidden">
          <div class="w-1/3 h-full bg-primary rounded-full"></div>
        </div>
        <div class="flex justify-between text-white/80 text-sm font-medium">
          <span>03:42</span>
          <span>12:05</span>
        </div>
      </div>
    </div>

  </div>
</section>
