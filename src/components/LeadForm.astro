---
---
<section id="lead-form" class="py-20 md:py-28 bg-surface relative overflow-hidden">
  <div class="absolute inset-0 bg-primary/5 clip-path-slant z-0"></div>
  
  <div class="container mx-auto px-4 md:px-6 relative z-10 max-w-4xl">
    
    <div class="bg-surface-container-lowest rounded-3xl shadow-soft p-8 md:p-12 border border-border/50">
      
      <!-- Form Header -->
      <div class="text-center max-w-2xl mx-auto mb-10" id="form-header">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-text-main mb-4">
          Получить разбор
        </h2>
        <p class="text-lg text-text-soft">
          Два поля. Видео пришлю в течение 2 рабочих дней.
        </p>
      </div>

      <!-- The Form -->
      <form id="audit-form" class="max-w-xl mx-auto space-y-6">
        
        <div class="space-y-2">
          <label for="website" class="block text-sm font-semibold text-text-main">
            Ссылка на ваш сайт <span class="text-error">*</span>
          </label>
          <input 
            type="url" 
            id="website" 
            name="website" 
            placeholder="https://вашсайт.ру" 
            required
            class="w-full px-4 py-3 rounded-xl border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
          />
        </div>

        <div class="space-y-2">
          <label for="contact" class="block text-sm font-semibold text-text-main">
            Телефон или Telegram для отправки видео <span class="text-error">*</span>
          </label>
          <input 
            type="text" 
            id="contact" 
            name="contact" 
            placeholder="+7 999 000-00-00 или @username" 
            required
            class="w-full px-4 py-3 rounded-xl border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
          />
        </div>

        <div class="space-y-2">
          <label for="issue" class="block text-sm font-semibold text-text-main">
            Что беспокоит по сайту <span class="text-text-muted font-normal">— необязательное поле</span>
          </label>
          <textarea 
            id="issue" 
            name="issue" 
            rows="3"
            placeholder="Например: показы растут, а заявок стало меньше" 
            class="w-full px-4 py-3 rounded-xl border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all resize-none"
          ></textarea>
        </div>

        <button 
          type="submit" 
          class="w-full bg-primary hover:bg-primary-container text-white font-bold text-lg py-4 px-8 rounded-xl shadow-soft hover:shadow-soft-hover transition-all duration-300 flex justify-center items-center gap-2 group"
        >
          Отправить заявку
          <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
        </button>

        <div class="text-center space-y-2 mt-4">
          <p class="text-sm text-text-main font-medium">
            Не звоню без предупреждения. Видео приходит ссылкой, дальше вы решаете сами.
          </p>
          <p class="text-xs text-text-muted">
            Нажимая кнопку, вы соглашаетесь с политикой конфиденциальности.
          </p>
        </div>
      </form>

      <!-- Success Message (Hidden by default) -->
      <div id="success-message" class="hidden text-center max-w-lg mx-auto py-8">
        <div class="w-20 h-20 bg-mint/20 text-mint rounded-full flex items-center justify-center mx-auto mb-6">
          <span class="material-symbols-outlined text-4xl">check_circle</span>
        </div>
        <h3 class="text-2xl font-bold text-text-main mb-4">Заявка принята</h3>
        <p class="text-lg text-text-soft leading-relaxed">
          Смотрю ваш сайт и записываю разбор — видео придёт в течение двух рабочих дней. Если по сайту есть вопрос, который обязательно нужно разобрать, напишите мне прямо сейчас: <a href="#" class="text-primary hover:underline font-medium">@denis_seo</a>.
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  .clip-path-slant {
    clip-path: polygon(0 0, 100% 5%, 100% 100%, 0 95%);
  }
</style>

<script>
  // Simple client-side form handling
  const form = document.getElementById('audit-form');
  const header = document.getElementById('form-header');
  const successMsg = document.getElementById('success-message');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // In a real app, send data to backend here.
      
      form.style.display = 'none';
      if (header) header.style.display = 'none';
      if (successMsg) successMsg.classList.remove('hidden');
    });
  }
</script>
